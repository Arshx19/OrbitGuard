# Point the dashboard at the FastAPI backend.
# Copy to .env.local (gitignored). Leave unset to run on mock data alone.
#
# Use 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first,
# and the server binds IPv4, so every request would pay for a refused
# connection before succeeding -- and fallback to mock data takes seconds longer.
VITE_API_BASE_URL=http://127.0.0.1:8000
